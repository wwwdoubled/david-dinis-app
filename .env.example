# Supabase — copia este ficheiro para .env.local e preenche
# URL e anon key do projecto. Não comites .env.local — está no .gitignore.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Chave usada pela rota /api/ler-print (etiquetas de seguros). Só servidor.
ANTHROPIC_API_KEY=sk-ant-...
